# Copy this file to ".env" and fill in the values.

# Leave EMPTY to use a local database file (cicero.db) on your computer.
# Put your free Neon PostgreSQL URL here to use the SAME data on your computer and on Vercel.
DATABASE_URL=

# Password to open the app. Leave empty = no login (OK on your own computer).
# ALWAYS set this on Vercel, because the website is public.
APP_PASSWORD=

# Any long random text (used to sign the login token)
SECRET_KEY=change-this-to-any-long-random-text
